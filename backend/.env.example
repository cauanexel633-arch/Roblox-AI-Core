# OpenRouter key: https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-COLOQUE_SUA_CHAVE_AQUI

# Gere uma chave aleatória longa para autenticar os servidores Roblox.
ROBLOX_AI_CORE_KEY=COLOQUE_UM_SEGREDO_ALEATORIO_LONGO_AQUI

# Roteador gratuito. Também pode ser substituído por um model ID específico.
OPENROUTER_MODEL=openrouter/free
OPENROUTER_SITE_URL=https://example.com
OPENROUTER_APP_NAME=Roblox AI Core
MAX_REQUESTS_PER_MINUTE=4
MAX_REQUESTS_PER_DAY=20
REQUEST_TIMEOUT_SECONDS=45
